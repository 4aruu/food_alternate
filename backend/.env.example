# ── Database ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=food_finder

# Or use a single connection URL (overrides individual fields above):
# DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# ── Runtime ───────────────────────────────────────────────
# Set to "production" to disable /docs, /redoc, /openapi.json
ENVIRONMENT=development

# Comma-separated frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:4028,http://localhost:5173

# Comma-separated valid Host header values (prevents host-header injection)
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Process (production only) ─────────────────────────────
# Number of gunicorn worker processes (default: 2)
# WEB_CONCURRENCY=2
